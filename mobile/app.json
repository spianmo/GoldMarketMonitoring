{
  "expo": {
    "name": "黄金盯盘",
    "slug": "goldmarket-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "goldmarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamhelper.goldmarketmonitoring",
      "infoPlist": {
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF8F3"
      },
      "package": "com.teamhelper.goldmarketmonitoring",
      "permissions": ["INTERNET", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E0A82E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
