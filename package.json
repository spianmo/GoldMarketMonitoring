{
  "name": "goldmarket-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "黄金盯盘 monorepo — desktop (Electron) + mobile (Expo) + shared types & utils",
  "scripts": {
    "dev:desktop": "pnpm --filter @goldmarket/desktop dev",
    "dev:mobile": "pnpm --filter @goldmarket/mobile start",
    "build:desktop": "pnpm --filter @goldmarket/desktop build",
    "build:shared": "pnpm --filter @goldmarket/shared build",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron",
      "esbuild",
      "@react-native/codegen-tools",
      "react-native-mmkv"
    ]
  }
}
